<ui:FluentWindow
    x:Class="TorrentIsland.Presentation.Player.Windows.Settings.Preferences"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:player="clr-namespace:TorrentIsland.Presentation.Player"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="600"
    MinWidth="600"
    MinHeight="650"
    MaxWidth="600"
    MaxHeight="650"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    ExtendsContentIntoTitleBar="True"
    PreviewKeyDown="Preferences_PreviewKeyDown"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <ui:TitleBar
            x:Name="TitleName"
            Title="Preferences"
            Grid.Row="0"
            ButtonsForeground="#AAAAAA"
            Foreground="White"
            ShowMinimize="False"
            ShowMaximize="False"
            Style="{StaticResource TituloGlobalStyle}">

            <ui:TitleBar.Icon>
                <ui:SymbolIcon
                    Filled="True"
                    Foreground="#2D323F"
                    Symbol="Glance24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
</ui:FluentWindow>