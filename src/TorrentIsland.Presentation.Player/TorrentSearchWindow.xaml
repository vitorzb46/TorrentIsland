<ui:FluentWindow
    x:Class="TorrentIsland.Presentation.Player.TorrentSearchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:player="clr-namespace:TorrentIsland.Presentation.Player"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="850"
    Height="500"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    Background="#1E1E1E"
    ExtendsContentIntoTitleBar="True"
    Foreground="White"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="15,0,15,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  BARRA DE TITULO  -->
        <ui:TitleBar
            Title="Buscar Torrents"
            Grid.Row="0"
            Icon="Search24" />

        <!--  BARRA DE PESQUISA  -->
        <Grid Grid.Row="1" Margin="0,15,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox
                x:Name="TxtSearch"
                KeyDown="TxtSearch_KeyDown"
                VerticalAlignment="Center"
                PlaceholderText="Digite o filme ou série..." />

            <ui:Button
                Grid.Column="1"
                Margin="10,0,0,0"
                Appearance="Primary"
                Click="BtnBuscar_Click"
                Content="Buscar" />
        </Grid>

        <!--  CABEÇALHO DA LISTA  -->
        <Grid Grid.Row="2" Margin="8,0,25,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="70" />
            </Grid.ColumnDefinitions>

            <ui:TextBlock
                Grid.Column="0"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="#888888"
                Text="Torrent" />
            <ui:TextBlock
                Grid.Column="1"
                HorizontalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="#888888"
                Text="Tamanho" />
            <ui:TextBlock
                Grid.Column="2"
                HorizontalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="#888888"
                Text="Seeds" />
            <ui:TextBlock
                Grid.Column="3"
                HorizontalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="#888888"
                Text="Leechers" />
        </Grid>

        <Border
            Grid.Row="2"
            Margin="0,0,0,0"
            VerticalAlignment="Bottom"
            BorderBrush="#33FFFFFF"
            BorderThickness="0,0,0,1" />

        <!--  LISTBOX COM ROLAGEM  -->
        <ListBox
            x:Name="ListBoxTorrents"
            Grid.Row="3"
            Background="#252526"
            BorderBrush="#3F3F46"
            MouseDoubleClick="ListBoxTorrents_MouseDoubleClick">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>

                            <ui:TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{Binding TorrentName}"
                                TextTrimming="CharacterEllipsis" />
                            <ui:TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="#AAAAAA"
                                Text="{Binding Size}" />
                            <ui:TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="#4CAF50"
                                Text="{Binding Seed, StringFormat='▲ {0}'}" />
                            <ui:TextBlock
                                Grid.Column="3"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="#F44336"
                                Text="{Binding Leech, StringFormat='▼ {0}'}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</ui:FluentWindow>
