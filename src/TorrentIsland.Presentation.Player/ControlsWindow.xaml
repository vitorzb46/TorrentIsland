<Window
    x:Class="TorrentIsland.Presentation.Player.ControlsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:player="clr-namespace:TorrentIsland.Presentation.Player"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Controls"
    Width="1280"
    Height="100"
    AllowsTransparency="True"
    Background="Transparent"
    MouseMove="Window_MouseMove"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SnapsToDevicePixels="True"
    Topmost="True"
    WindowStyle="None">

    <Window.Resources>
        <Style x:Key="PlayerButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>


                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#26FFFFFF" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#E60A0A0A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#2D323F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Bahnschrift" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimeTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Bahnschrift" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FeedbackStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Bahnschrift" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="10"
                        Opacity="0.8"
                        ShadowDepth="0"
                        Color="Black" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border
        Width="1100"
        Height="75"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="#E61A1E24"
        BorderBrush="#2D323F"
        BorderThickness="1"
        CornerRadius="8">

        <Grid Margin="20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Slider
                x:Name="TimelineSlider"
                Grid.Row="0"
                Height="12"
                Margin="0,-4,0,0"
                VerticalAlignment="Top"
                Background="Transparent"
                Maximum="{Binding DuracaoTotalEmMilissegundos, Mode=OneWay}"
                Minimum="0"
                MouseMove="TimelineSlider_MouseMove"
                PreviewMouseDown="TimelineSlider_PreviewMouseDown"
                PreviewMouseUp="TimelineSlider_PreviewMouseUp"
                Value="{Binding PosicaoEmMilissegundos, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Grid Grid.Row="1" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        x:Name="RetrocederButton"
                        Click="RetrocederButton_Click"
                        Content="⏪"
                        FontSize="13"
                        Style="{StaticResource PlayerButtonStyle}" />
                    <Button
                        x:Name="PlayPauseButton"
                        Click="PlayPauseButton_Click"
                        FontSize="18">
                        <Button.Style>
                            <Style BasedOn="{StaticResource PlayerButtonStyle}" TargetType="Button">
                                <Setter Property="Content" Value="▶" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Content" Value="⏸" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button
                        x:Name="AvancarButton"
                        Click="AvancarButton_Click"
                        Content="⏩"
                        FontSize="13"
                        Style="{StaticResource PlayerButtonStyle}" />
                    <Button
                        x:Name="MuteButton"
                        Click="MuteButton_Click">
                        <Button.Style>
                            <Style BasedOn="{StaticResource PlayerButtonStyle}" TargetType="Button">
                                <Setter Property="Content" Value="🔊" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                        <Setter Property="Content" Value="🔇" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Slider
                        x:Name="VolumeSlider"
                        Width="100"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Maximum="100"
                        Minimum="0"
                        ValueChanged="VolumeSlider_ValueChanged"
                        Value="{Binding Volume, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

                    <StackPanel
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">

                        <TextBlock Style="{StaticResource TimeTextStyle}" Text="{Binding TempoAtualFormatado}" />
                        <TextBlock
                            Foreground="#99FFFFFF"
                            Style="{StaticResource TimeTextStyle}"
                            Text=" / " />
                        <TextBlock
                            Foreground="#99FFFFFF"
                            Style="{StaticResource TimeTextStyle}"
                            Text="{Binding TempoTotalFormatado}" />
                    </StackPanel>

                    <Button
                        x:Name="LoadMediaButton"
                        Click="LoadMediaButton_Click"
                        Content="📁"
                        FontSize="16"
                        Style="{StaticResource PlayerButtonStyle}" />

                    <Button
                        x:Name="SettingsButton"
                        Click="SettingsButton_Click"
                        Style="{StaticResource PlayerButtonStyle}"
                        Tag="{Binding}">

                        <Button.Content>
                            <ui:SymbolIcon
                                FontSize="16"
                                Foreground="White"
                                Symbol="Settings24" />
                        </Button.Content>

                        <Button.ContextMenu>
                            <ContextMenu x:Name="ConfigMenu">

                                <!--  Buscar Torrents  -->
                                <MenuItem Click="BuscarTorrentMenuItem_Click" Header="🔍 Buscar Torrents" />

                                <!--  Adicionar Torrent  -->
                                <MenuItem Click="TorrentMenuItem_Click" Header="☠ Adicionar Torrent" />

                                <!--  ÁUDIO  -->
                                <MenuItem
                                    DisplayMemberPath="Name"
                                    Header="🗣 Idioma do Áudio"
                                    ItemsSource="{Binding AudioTracks}"
                                    MenuItem.Click="AudioMenuGroup_Click">
                                    <MenuItem.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Tag" Value="{Binding}" />
                                            <Setter Property="StaysOpenOnClick" Value="True" />
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>

                                <!--  LEGENDAS  -->
                                <MenuItem
                                    DisplayMemberPath="Name"
                                    Header="💬 Legendas"
                                    ItemsSource="{Binding SubtitleTracks}"
                                    MenuItem.Click="SubtitleMenuGroup_Click">
                                    <MenuItem.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Tag" Value="{Binding}" />
                                            <Setter Property="StaysOpenOnClick" Value="True" />
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>

                                <!--  Linha separador  -->
                                <Separator Margin="0,4">
                                    <Separator.Template>
                                        <ControlTemplate TargetType="Separator">
                                            <Rectangle
                                                Height="1"
                                                HorizontalAlignment="Stretch"
                                                Fill="#2D323F" />
                                        </ControlTemplate>
                                    </Separator.Template>
                                </Separator>

                                <!--  Informações do Torrent  -->
                                <MenuItem Header="🌐 Informações do Torrent" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button
                        x:Name="FullscreenButton"
                        Click="FullscreenButton_Click"
                        Style="{StaticResource PlayerButtonStyle}">
                        <ui:SymbolIcon
                            FontSize="16"
                            Foreground="White"
                            Symbol="FullScreenMaximize24" />
                    </Button>
                </StackPanel>
            </Grid>
            <Grid
                Grid.Row="1"
                Grid.RowSpan="2"
                IsHitTestVisible="False"
                Visibility="{Binding MostrarFeedback, Converter={StaticResource BoolToVisibilityConverter}}">

                <Border
                    Padding="24,16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#CC000000"
                    CornerRadius="12">

                    <TextBlock Style="{StaticResource FeedbackStyle}" Text="{Binding FeedbackTempo}" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
