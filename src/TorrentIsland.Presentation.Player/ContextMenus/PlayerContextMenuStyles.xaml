<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Cores base  -->
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#EDEDED" />
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#FFA0A0A0" />
    <SolidColorBrush x:Key="MenuForegroundBrush" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#2C96E8" />
    <SolidColorBrush x:Key="MenuHoverForeground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="MenuDisabledBrush" Color="#FF9A9A9A" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#FFD0D0D0" />

    <!--  ContextMenu  -->
    <Style x:Key="ClassicContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource MenuBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource MenuBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource MenuForegroundBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                        <StackPanel
                            Margin="{TemplateBinding Padding}"
                            IsItemsHost="True"
                            KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  MenuItem  -->
    <Style x:Key="ClassicMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource MenuForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="20,4,20,4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Icon" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  Ícone / check  -->
                            <ContentPresenter
                                x:Name="Icon"
                                Grid.Column="0"
                                Margin="4,0,4,0"
                                VerticalAlignment="Center"
                                ContentSource="Icon" />

                            <!--  Texto  -->
                            <ContentPresenter
                                Grid.Column="1"
                                Margin="4,0,20,0"
                                VerticalAlignment="Center"
                                ContentSource="Header"
                                RecognizesAccessKey="True" />

                            <!--  Atalho (Ctrl+Z etc.)  -->
                            <TextBlock
                                Grid.Column="2"
                                Margin="20,0,8,0"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource MenuDisabledBrush}"
                                Text="{TemplateBinding InputGestureText}" />

                            <!--  Seta de submenu  -->
                            <Path
                                x:Name="SubmenuArrow"
                                Grid.Column="3"
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                Data="M 0,0 L 4,4 L 0,8 Z"
                                Fill="{StaticResource MenuForegroundBrush}"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource MenuHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource MenuHoverForeground}" />
                            <Setter TargetName="SubmenuArrow" Property="Fill" Value="{StaticResource MenuHoverForeground}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource MenuDisabledBrush}" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Separator  -->
    <Style x:Key="ClassicMenuSeparatorStyle" TargetType="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="4,3,4,3" />
        <Setter Property="Background" Value="{StaticResource MenuSeparatorBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border
                        Height="1"
                        Background="{TemplateBinding Background}"
                        SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
